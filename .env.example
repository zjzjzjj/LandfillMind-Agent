# ====================
# 可选通道：OpenRouter（默认关闭；填入 API Key 后启用）
# ====================
# 1. 打开 https://openrouter.ai/keys 创建 API Key
# 2. 免费档有每日请求上限，建议在 OpenRouter 后台关注用量
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
# 可选：逗号分隔，额外模型会出现在前端模型下拉里
OPENROUTER_MODELS=dots-studio/dots-3-note-preview:free
OPENROUTER_LABEL=OpenRouter

# ====================
# 默认唯一通道：智谱 GLM 免费模型（0 元不限量，国内直连）
# ====================
# 1. 打开 https://open.bigmodel.cn → 手机号注册 → 实名认证
# 2. 控制台「API Keys」创建 Key：https://bigmodel.cn/usercenter/proj-mgmt/apikeys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 注意：glm-4.7-flash 实测常返回空正文，默认改用 glm-4-flash-250414
OPENAI_MODEL=glm-4-flash-250414
OPENAI_LABEL=智谱 GLM（直连）
# 可选：逗号分隔，额外模型会出现在前端模型下拉里
OPENAI_MODELS=glm-4-flash-250414

# ====================
# 备选引擎
# ====================
# CodeBuddy Agent SDK 主密钥（有则用 CodeBuddy 为主引擎）
CODEBUDDY_API_KEY=

# DeepSeek 官方直连（独立可选通道；填 Key 后 deepseek-flash 出现在前端模型下拉）
# 控制台：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# 本通道模型锁定 deepseek-flash（server/llm.ts 的 DEEPSEEK_ALLOWED_MODELS）。
# DEEPSEEK_MODEL 只能在该白名单内取值，填其它名字会被归一回 deepseek-flash。
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_LABEL=DeepSeek（直连）

# ====================
# 服务配置
# ====================
PORT=3000
NODE_ENV=development
# 反代之后取真实 IP（Render 等平台部署时设为 1）
TRUST_PROXY=

# ====================
# 演示限流（防刷 Key，可调）
# ====================
RATE_LIMIT_PER_MIN=40
RATE_LIMIT_PER_DAY=1000
RATE_LIMIT_GLOBAL_PER_DAY=5000

# ====================
# 数据库配置
# ====================
DB_PATH=./data/chat.db

# ====================
# OGS 数值模拟（OpenGeoSys 求解器）
# ====================
# 求解器 exe 路径。默认使用仓库内置 OGS/bin/ogs.exe（OGS5.5）。
# 若未内置或想用其它版本，可在此指定绝对路径，例如：
# OGS_EXE=F:\文档\OGS\案例\TH2M\ogs.exe

# ====================
# 权威内核（Landfill 3D Tool Python 仓库，同机部署）
# ====================
# 仓库根目录（含 agent_bridge.py 与 landfill3d 包）。默认已指向本机常用位置，
# 路径含空格/中文无需加引号（Node spawn 数组 argv 自动处理）：
# KERNEL3D_REPO_PATH=E:\ZJU\ZJU\三维建模\Landfill 3D Tool
# Python 命令。本机 python 是商店占位符，默认用 py 启动器；也可指绝对路径 python.exe：
# KERNEL3D_PY=py
# 单次内核调用超时覆盖（毫秒，默认按动作 60s~300s 分级）：
# KERNEL3D_TIMEOUT_MS=
# 未配置/找不到时 run_3d_kernel 返回可读错误信封，不影响其它功能。

