  "slope_stability_Fs": {
    "description": "抗滑稳定性安全系数 Fs 分级警戒值(运行期/封场后)",
    "运行期正常": {
      "value": "≥ 1.30",
      "level": "blue/green 安全",
      "action": "正常运行,按常规频次监测"
    },
    "运行期注意": {
      "value": "1.20 ~ 1.30",
      "level": "yellow 注意",
      "action": "加密监测,分析趋势"
    },
    "运行期警示": {
      "value": "1.10 ~ 1.20",
      "level": "orange 警示",
      "action": "启动应急预案,限载削坡"
    },
    "运行期危险": {
      "value": "< 1.10",
      "level": "red 危险",
      "action": "立即停产、人员撤离、专家会商"
    },
    "封场后稳定期": {
      "value": "≥ 1.20",
      "note": "封场后堆体进入次稳定状态,允许Fs适当降低"
    },
    "地震工况": {
      "value": "≥ 1.15",
      "note": "按 CJJ 176-2012 表6.1.4 安全等级分档：一级(堆高≥60m)≥1.15 / 二级(30~60m)≥1.10 / 三级(<30m)≥1.05；缺省按一级保守值 1.15"
    },
    "暴雨工况": {
      "value": "≥ 1.15",
      "note": "降雨入渗导致水位抬升、抗剪强度下降"
    },
    "source": "CJJ 176-2012 §4.5.5; CJJ/T 213-2016 §6.2",
    "source_url": "https://www.mohurd.gov.cn/gongkai/zhengce/zhengcereport/201612/20161213_XXXX.html"
  },

  "leachate_level": {
